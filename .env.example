# Health/validation work without AI. Ollama inference requires no API key.
VERICOMMIT_APP_NAME=VeriCommit
VERICOMMIT_HOST=127.0.0.1
VERICOMMIT_PORT=8000
VERICOMMIT_RELOAD=false
VERICOMMIT_LOG_LEVEL=info
# JSON array of exact frontend origins. Set deployed origins explicitly; no wildcard.
VERICOMMIT_CORS_ORIGINS=["http://localhost:3000"]

# Explicit selection: ollama (local), openai, or groq. No automatic fallback.
# The application default is openai for compatibility with existing configurations.
VERICOMMIT_AI_PROVIDER=ollama
VERICOMMIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
VERICOMMIT_OLLAMA_MODEL=qwen2.5:3b
VERICOMMIT_OLLAMA_TIMEOUT_SECONDS=120

# Hosted providers: leave keys blank until supplied locally; never commit them.
VERICOMMIT_OPENAI_API_KEY=
VERICOMMIT_AI_MODEL=gpt-4o-mini
VERICOMMIT_AI_TIMEOUT_SECONDS=30
# Groq requires an explicit model with strict JSON Schema support and account access.
# Check current model access and free-tier limits in the Groq console.
VERICOMMIT_GROQ_API_KEY=
VERICOMMIT_GROQ_MODEL=

# Public GitHub retrieval works anonymously. Optional server-only token for quota.
VERICOMMIT_GITHUB_TOKEN=
VERICOMMIT_GITHUB_TIMEOUT_SECONDS=10
VERICOMMIT_GITHUB_TOTAL_TIMEOUT_SECONDS=60
VERICOMMIT_GITHUB_PAGE_SIZE=5
VERICOMMIT_GITHUB_MAX_PAGES=2
VERICOMMIT_GITHUB_MAX_REQUESTS=25
